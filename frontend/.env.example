# Copy to frontend/.env(.local) and fill in a real token.
# Must match one of the tokens configured server-side in MJ_API_TOKENS
# (see ../.env.example). Baked into the built JS bundle at build time -
# do not use a token here that needs to stay secret from end users of a
# publicly deployed build; for a single-operator/local deployment this is
# fine.
VITE_MJ_API_TOKEN=change-me-to-a-random-token

# Absolute URL of the deployed backend, no trailing slash (e.g.
# https://mj-chat-bot.onrender.com). Leave blank for local dev - vite.config.js
# proxies /api to 127.0.0.1:8086 there instead.
VITE_API_BASE_URL=
