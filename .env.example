# Copy this file to .env at the project root and fill in real values.
# .env is gitignored - never commit real secrets.

# --- LLM providers ---
GROQ_API_KEY=gsk_your_groq_key_here
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here
GEMINI_API_KEY=
DASHSCOPE_API_KEY=
PINECONE_API_KEY=

# --- Storage ---
# Leave blank to fall back to a local backend/memory.json file.
MONGO_URI=

# --- API authentication (backend/auth.py) ---
# Comma-separated list of "token" or "token:identity" pairs. Every /api/*
# route requires one of these as a bearer token. A bare token (no ":identity")
# is assigned the identity "default". Generate strong tokens, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Example with two identities sharing one server:
#   MJ_API_TOKENS=change-me-1:alice,change-me-2:bob
MJ_API_TOKENS=change-me-to-a-random-token

# --- Chat rate limiting (backend/server.py) ---
# Requests/minute per client for POST /api/chat.
MJ_CHAT_RATE_LIMIT_AUTHENTICATED=60/minute
MJ_CHAT_RATE_LIMIT_ANONYMOUS=10/minute
